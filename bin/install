#!/usr/bin/env bash
# ==============================================================================
# Antigravity Hub — Arch Linux Package & Local Installation Automation Script
# ==============================================================================
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_NAME="antigravity-hub"
HYPR_CONF="${HOME}/.config/hypr/hyprland.lua"

usage() {
    cat <<EOF
Usage: bin/install [OPTIONS] [-- [MAKEPKG_FLAGS...]]

Options:
  --pkg, -p         Build and install via Arch PKGBUILD (makepkg -fsi --noconfirm) [Default]
  --local, -l       Install directly to user space (~/.local/) without sudo
  --hyprland, -H    Register floating window rule in ~/.config/hypr/hyprland.lua
  --all, -a         Install package and register Hyprland window rules
  --help, -h        Show this help message

Examples:
  bin/install                      # Standard Arch package install
  bin/install --local              # Local user-space install without sudo
  bin/install --hyprland           # Register Hyprland floating window rule
  bin/install --all                # Complete package & desktop integration
EOF
    exit 0
}

MODE="default"
INSTALL_HYPR=false
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --pkg|-p)
            MODE="pkg"
            shift
            ;;
        --local|-l)
            MODE="local"
            shift
            ;;
        --hyprland|-H)
            INSTALL_HYPR=true
            shift
            ;;
        --all|-a)
            MODE="pkg"
            INSTALL_HYPR=true
            shift
            ;;
        --help|-h)
            usage
            ;;
        --)
            shift
            EXTRA_ARGS=("$@")
            break
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

# If only --hyprland was specified without explicit --pkg or --local, do not rebuild or package unless requested
if [[ "${MODE}" == "default" && "${INSTALL_HYPR}" == true ]]; then
    MODE="none"
elif [[ "${MODE}" == "default" ]]; then
    MODE="pkg"
fi

if [[ "${MODE}" != "none" ]]; then
    echo -e "\033[1;34m==>\033[0m Building ${BIN_NAME} binary..."
    "${ROOT}/bin/build"
fi

if [[ "${MODE}" == "pkg" ]]; then
    echo -e "\033[1;34m==>\033[0m Packaging and installing with makepkg..."
    
    if [[ "${EUID}" -eq 0 ]]; then
        echo -e "\033[1;31mError:\033[0m makepkg cannot be executed as root. Use --local or run as normal user." >&2
        exit 1
    fi

    PKGBUILD_DIR="${ROOT}/pkgbuild"
    if [[ ! -d "${PKGBUILD_DIR}" || ! -f "${PKGBUILD_DIR}/PKGBUILD" ]]; then
        PKGBUILD_DIR="${ROOT}"
    fi

    cd "${PKGBUILD_DIR}"
    
    # Invokes makepkg -fsi --noconfirm
    makepkg -fsi --noconfirm "${EXTRA_ARGS[@]}"
    
    echo -e "\033[1;32m✔\033[0m ${BIN_NAME} Arch package installed successfully."

elif [[ "${MODE}" == "local" ]]; then
    echo -e "\033[1;34m==>\033[0m Installing to user space (~/.local)..."
    
    BIN_DIR="${HOME}/.local/bin"
    APP_DIR="${HOME}/.local/share/applications"
    ICON_DIR="${HOME}/.local/share/icons/hicolor/scalable/apps"
    
    mkdir -p "${BIN_DIR}" "${APP_DIR}" "${ICON_DIR}"
    
    # 1. Install binary executable (mode 755)
    install -Dm755 "${ROOT}/build/${BIN_NAME}" "${BIN_DIR}/${BIN_NAME}"
    
    # 2. Install desktop entry (mode 644)
    DESKTOP_SRC="${ROOT}/pkgbuild/${BIN_NAME}.desktop"
    [[ -f "${DESKTOP_SRC}" ]] || DESKTOP_SRC="${ROOT}/${BIN_NAME}.desktop"
    if [[ -f "${DESKTOP_SRC}" ]]; then
        install -Dm644 "${DESKTOP_SRC}" "${APP_DIR}/${BIN_NAME}.desktop"
        if command -v update-desktop-database &>/dev/null; then
            update-desktop-database "${APP_DIR}" 2>/dev/null || true
        fi
    fi
    
    # 3. Install scalable SVG icon (mode 644)
    ICON_SRC="${ROOT}/pkgbuild/${BIN_NAME}.svg"
    [[ -f "${ICON_SRC}" ]] || ICON_SRC="${ROOT}/${BIN_NAME}.svg"
    if [[ -f "${ICON_SRC}" ]]; then
        install -Dm644 "${ICON_SRC}" "${ICON_DIR}/${BIN_NAME}.svg"
        if command -v gtk-update-icon-cache &>/dev/null; then
            gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" 2>/dev/null || true
        fi
    fi
    
    echo -e "\033[1;32m✔\033[0m Successfully installed ${BIN_NAME} to ${BIN_DIR}/${BIN_NAME}."
fi

# Hyprland window rule configuration
if [[ "${INSTALL_HYPR}" == true ]]; then
    echo -e "\033[1;34m==>\033[0m Configuring Hyprland window rule..."
    if [[ -f "${HYPR_CONF}" ]]; then
        if grep -q "antigravity-hub" "${HYPR_CONF}"; then
            echo -e "\033[1;33m!\033[0m Hyprland window rule for antigravity-hub already present. Skipping."
        else
            cp "${HYPR_CONF}" "${HYPR_CONF}.bak_$(date +%Y%m%d_%H%M%S)"
            cat >> "${HYPR_CONF}" <<'EOF'

-- Antigravity Hub: Omarchy native floating window
o.window("^antigravity-hub$", {
  float = true,
  center = true,
  size = { 1080, 720 },
})
EOF
            if command -v hyprctl &>/dev/null; then
                hyprctl reload
                ERR=$(hyprctl configerrors 2>&1 || true)
                if [[ -n "${ERR}" && "${ERR}" != "no flags were set" ]]; then
                    echo -e "\033[1;31mWarning:\033[0m Hyprland config warning: ${ERR}" >&2
                else
                    echo -e "\033[1;32m✔\033[0m Hyprland rule registered and reloaded."
                fi
            fi
        fi
    else
        echo -e "\033[1;33m!\033[0m ${HYPR_CONF} not found. Skipping Hyprland configuration."
    fi
fi

echo -e "\033[1;32m🎉 Antigravity Hub installation complete!\033[0m"
